{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kinetic-layers",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "kinetic-layers-v2",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "KL_SAMPLES=1",
        "npx",
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "kinetic-layers-v2-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "--turbopack",
        "-p",
        "3101"
      ],
      "port": 3101
    }
  ]
}
