{
  "name": "kinetic-layers",
  "version": "0.1.0",
  "private": true,
  "description": "Demand test for an original website-layer collection aimed at agencies.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "readout": "node tools/readout.mjs",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "seed": "node tools/seed-sanity.mjs /tmp/kl-seed.ndjson && sanity dataset import /tmp/kl-seed.ndjson production --replace",
    "media": "node --env-file=.env.local tools/make-dummy-media.mjs",
    "media:upload": "node --env-file=.env.local tools/upload-r2.mjs",
    "media:deploy": "npx --yes wrangler@4 pages deploy public/preview --project-name kinetic-layers-media --branch main --commit-dirty=true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.47.10",
    "framer-motion": "^13.4.0",
    "next": "^15.1.6",
    "next-sanity": "^11.6.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@sanity/vision": "^4.22.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "pg": "^8.23.0",
    "sanity": "^4.22.1",
    "styled-components": "^6.5.3",
    "typescript": "^5.7.3"
  }
}
