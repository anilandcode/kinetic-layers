# Supabase — server-side only. The service role key must never be exposed to
# the browser, so neither of these is prefixed NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Address offered to a visitor when their submission fails to send.
# Must be a mailbox that actually exists before this goes live.
NEXT_PUBLIC_CONTACT_EMAIL=hello@directionkit.com

# Optional consent-based email provider. Without these the form still works:
# every response is stored in Supabase and nothing is sent to a third party.
# Provider is one of: mailerlite | convertkit | buttondown
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_LIST_ID=
