# Sanity — the catalogue. Public dataset, read-only from the app.
NEXT_PUBLIC_SANITY_PROJECT_ID=8vxxthrc
NEXT_PUBLIC_SANITY_DATASET=production
# Shared with the Sanity webhook so an edit invalidates the right cache tags.
SANITY_REVALIDATE_SECRET=

# Supabase — identity, entitlement and the private file bucket.
# The publishable key is designed to ship in the browser: RLS is what protects
# the data. Find it in the dashboard under Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS — used for granting entitlement, signing Storage
# URLs after the gate has passed, and the legacy demand-test routes.
SUPABASE_SECRET_KEY=

# Only needed by tools/apply-migration.mjs.
SUPABASE_DB_PASSWORD=

# Guards /api/admin/grant, which stands in for Stripe's webhook until checkout
# exists. Rotate it when that lands.
KILN_ADMIN_TOKEN=

# Offered to a visitor when a form fails to send. Must be a real mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=hello@kiln.design

# Optional consent-based email provider for the Thursday digest.
# One of: mailerlite | convertkit | buttondown
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_LIST_ID=

# Preview media (posters + looping clips).
#
# Public by design — previews are the marketing. "/preview" serves the local
# dummies in public/preview; swap in the R2 bucket's public URL to serve from
# Cloudflare, which charges nothing for egress at any volume.
NEXT_PUBLIC_MEDIA_BASE=/preview

# Only tools/upload-r2.mjs needs these. The app never talks to R2 directly —
# it just builds URLs.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kiln-preview
