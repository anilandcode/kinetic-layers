# The canonical origin, used for canonical tags, the sitemap, OG image URLs,
# Stripe redirect URLs and every auth email link. Set this in production.
# Without it the app falls back to the Vercel domain, then to localhost — and a
# localhost link in a password-reset email is a dead end.
NEXT_PUBLIC_SITE_URL=https://kineticlayers.com

# Sanity — the catalogue. Public dataset, read-only from the app.
NEXT_PUBLIC_SANITY_PROJECT_ID=8vxxthrc
NEXT_PUBLIC_SANITY_DATASET=production
# Shared with the Sanity webhook so an edit invalidates the right cache tags.
SANITY_REVALIDATE_SECRET=

# Read token for the catalogue. Server-only — never NEXT_PUBLIC_.
#
# The dataset is public, but anonymous reads on this project only return the
# document types that predate the `tag` type: an authenticated query sees 33
# tags and an anonymous one sees none, and the same is true of any newly created
# type. Without this, `tags[]->title` dereferences to nothing and the library
# has no categories.
#
# Create at sanity.io/manage → API → Tokens with the **Viewer** role. It only
# ever reads, and `perspective: "published"` in lib/sanity/client.ts means it
# cannot surface drafts. Leave it empty and the app behaves as it did before —
# everything works except tags.
SANITY_API_READ_TOKEN=

# Supabase — identity, entitlement and the private file bucket.
# The publishable key is designed to ship in the browser: RLS is what protects
# the data. Find it in the dashboard under Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS — used for granting entitlement, signing Storage
# URLs after the gate has passed, and the legacy demand-test routes.
SUPABASE_SECRET_KEY=

# Only needed by tools/apply-migration.mjs.
SUPABASE_DB_PASSWORD=

# Guards /api/admin/grant, which stands in for Stripe's webhook until checkout
# exists. Rotate it when that lands.
ADMIN_TOKEN=

# Offered to a visitor when a form fails to send. Must be a real mailbox.
NEXT_PUBLIC_CONTACT_EMAIL=hello@kiln.design

# Optional consent-based email provider for the Thursday digest.
# One of: mailerlite | convertkit | buttondown
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_LIST_ID=

# Preview media (posters + looping clips).
#
# Public by design — previews are the marketing. "/preview" serves the local
# dummies in public/preview; swap in the R2 bucket's public URL to serve from
# Cloudflare, which charges nothing for egress at any volume.
NEXT_PUBLIC_MEDIA_BASE=/preview

# Serve Studio uploads from Cloudflare instead of cdn.sanity.io, and size every
# file through /cdn-cgi/ on the way out. Leave this off until all three are
# true, because half-configured it produces 404s rather than large files:
#
#   1. the bucket has the custom domain above attached (R2 -> Custom Domains);
#   2. Transformations are enabled on the kineticlayers.com zone;
#   3. workers/media is deployed to that hostname.
#
# Off, lib/kl/media.ts behaves exactly as it always did.
NEXT_PUBLIC_MEDIA_MIRROR=0

# Which store holds the gated source files: "supabase" (default) or "r2".
# Supabase's free tier allows 1 GB and 5 GB egress a month; R2 gives 10 GB and
# charges nothing for egress at any volume. Flip this to cut over, and flip it
# back to roll back — see tools/migrate-storage-to-r2.mjs.
STORAGE_DRIVER=supabase

# R2 credentials. Shared by both buckets below; R2 needs a payment method on
# file even on the free tier.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The PUBLIC preview bucket — posters and clips, used by tools/upload-r2.mjs.
R2_BUCKET=kinetic-layers-preview

# The PRIVATE bucket holding the gated source files, used when
# STORAGE_DRIVER=r2. Deliberately a separate variable: signing a paid asset out
# of the public preview bucket would hand it to anyone with the URL. Give this
# bucket no public development URL and no custom domain.
R2_ASSETS_BUCKET=kinetic-layers-assets
