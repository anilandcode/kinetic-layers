# dependencies
node_modules/
.pnp
.pnp.js

# next
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# env — never commit keys
.env
.env*.local
.env.production
# Backups of the above are still secrets — .env*.local does not catch
# ".env.local.bak", and a stray copy is the easiest way to leak a key.
.env*.bak
*.env.bak

# vercel
.vercel
.pnpm-store/

# local data from the old PHP build
site/.data/
api/config.php

# os
.DS_Store
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# supabase cli scratch state — machine-local, rewritten on every link
supabase/.temp/

# Generated preview media — rebuild with tools/make-dummy-media.mjs
public/preview/

# `vercel link` appends a blanket `.env*` here, which also swallows
# .env.example — the one file that tells a new clone which variables exist.
# Ignore the real ones by name and keep the example visible.
.env*
!.env.example

# Vercel project link (contains project and org ids, not secrets, but local).
.vercel
.dev.vars
.open-next/
.wrangler/

# graphify knowledge graph. Regenerable from source in seconds with
# `graphify update .` (AST only, no API cost), so it is not worth the ~2 MB
# of churn on every commit.
graphify-out/

# Sanity Studio build output — `sanity deploy` regenerates both
dist/
.sanity/

# Node compile cache — machine-local build artefact
node-compile-cache/

# General Sans is licensed for self-hosting, not for redistribution through a
# public repository. Fetched at build time by tools/fetch-fonts.mjs; see docs/FONTS.md.
public/fonts/general-sans/
